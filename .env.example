PORT=9999

# Number of trusted reverse-proxy hops in front of the API (0 for direct access)
TRUST_PROXY_HOPS=0

# In-memory GET response cache duration and per-IP request limit
CACHE_TTL_MS=30000
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# Connect to Supabase via connection pooling 
DATABASE_URL="postgresql://postgres.cjlyhipchgapcilwynhy:store-management-db@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://postgres.cjlyhipchgapcilwynhy:store-management-db@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

JWT_SECRET=store-management-jwt-secret
ACCESS_TOKEN_SECRET=store-management-access-token-secret
REFRESH_TOKEN_SECRET=store-management-refresh-token-secret

# Cloudflare R2 credentials
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT_URL=
R2_BUCKET=your-r2-bucket-name
# R2.dev URL or a custom domain connected to the bucket (no trailing slash)
R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev

# Admin credentials
